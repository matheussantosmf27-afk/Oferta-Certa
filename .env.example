# Copie para .env.local e preencha. Nunca faça commit de valores reais.

# Supabase — públicas (podem ir para o navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — SOMENTE servidor. Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: código de verificação do Google Search Console (só o valor do content da meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
